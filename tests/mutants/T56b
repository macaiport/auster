# file: tools/check-registry
# accept an editor's added newline: each asset also counts as its hash without one final newline
s/| cut -c1-64; done)$/| cut -c1-64; n=$(wc -c < "$f"); [ "$(tail -c 1 "$f" | od -An -tx1 | tr -d ' ')" = 0a ] \&\& head -c $((n - 1)) "$f" | shasum -a 256 | cut -c1-64; done)/
