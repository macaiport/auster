# file: common/auster
# rollback using kickstart while stopped: once the programs are back, the engine is restarted with kickstart -k and checked
/^au_rollback_programs() {/,/^}/s/^  \/bin\/bash "\$AU_DATA\/bin\/auster" start$/  AU_T0=$(date +%s); launchctl kickstart -k "gui\/$AU_UID\/$AU_LABEL_ENGINE"; au_checked/
