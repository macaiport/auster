#!/bin/bash
# Stub openssl. Logs every call (tests/stub-lib.sh); anything not listed here is refused, so that a test
# never reaches the real openssl by accident.
#   rand N        the bytes in STUB_OPENSSL_RAND_HEX (pairs of hex digits), as they are
#   rand -hex N   the same bytes as hex, and a newline
#   Each call takes the next line of the file STUB_OPENSSL_RAND_FILE instead, when that is set (one
#   hex value a line, used once each, failing loudly when they run out), so that keys can differ.
#   STUB_OPENSSL_RAND_COUNTER, a file holding a count (absent is 0), wins over both: each call adds one
#   to the count and gives N bytes, each the count's low byte, so that every call of a run differs and
#   has the length asked for (01 01 ..., then 02 02 ...).
#   dgst -sha256 [FILE], sha256 [FILE]   the file's sha256 (by shasum), in the Mac's own openssl's form
. "$(dirname "$0")/../stub-lib.sh"
stub_begin "$@"
next_hex() {
  if [ -n "${STUB_OPENSSL_RAND_FILE:-}" ]; then
    h=$(head -n 1 "$STUB_OPENSSL_RAND_FILE")
    [ -n "$h" ] || stub_untold "STUB_OPENSSL_RAND_FILE has no values left"
    tail -n +2 "$STUB_OPENSSL_RAND_FILE" > "$STUB_OPENSSL_RAND_FILE.next" && mv "$STUB_OPENSSL_RAND_FILE.next" "$STUB_OPENSSL_RAND_FILE"
  else
    h=${STUB_OPENSSL_RAND_HEX:-}
    [ -n "$h" ] || stub_untold "set STUB_OPENSSL_RAND_HEX or STUB_OPENSSL_RAND_FILE"
  fi
}
case "${1:-}" in
  rand)
    if [ -n "${STUB_OPENSSL_RAND_COUNTER:-}" ]; then
      n=${!#}; c=$(( $(cat "$STUB_OPENSSL_RAND_COUNTER" 2>/dev/null || echo 0) + 1 ))
      echo "$c" > "$STUB_OPENSSL_RAND_COUNTER"
      b=$(printf '%02x' $((c % 256))); h=
      for ((i = 0; i < n; i++)); do h+=$b; done
    else
      next_hex
    fi
    if [ "${2:-}" = -hex ]; then echo "$h"; exit 0; fi
    while [ -n "$h" ]; do printf "\\x${h:0:2}"; h=${h:2}; done ;;
  dgst|sha256)
    [ "$1" = sha256 ] && shift || { [ "${2:-}" = -sha256 ] || stub_untold "only dgst -sha256"; shift 2; }
    if [ $# -eq 0 ]; then shasum -a 256 | cut -c1-64
    else for f in "$@"; do
      [ -r "$f" ] || { echo "$f: No such file or directory" >&2; exit 1; }
      echo "SHA256($f)= $(shasum -a 256 < "$f" | cut -c1-64)"
    done; fi ;;
  *) echo "stub openssl: only rand and dgst -sha256" >&2; exit 1 ;;
esac
