#!/bin/bash
# auster: the `auster` command (docs/plans/v0.1.md, B6), and the shell functions the driver
# (common/driver.sh) shares with it. The driver copies this file byte for byte to <data root>/bin/auster
# (B3 step 3) and loads it with `.`, which defines functions and constants only; run as a program, it
# runs auster_main.
#
# Built by V5 (2026-11-26): the shared functions (the data root and its ownership, the lock, questions
# from the terminal, the job verbs, the server check), `remove` and the start of `status`. V6 made the
# server check fail closed. V7 (2026-11-26): every subcommand of B6 that needs no update, the keys and the
# QR code (B7), the line in ~/.zprofile (B6), and removal whole (B8); tests T72 (its revoke clause), T81 to
# T87, T106, T108, T113 and T114. Still to come, each marked TODO below:
#   U4  `update`;  U5  `people`'s change of setting, and T107's rows for these commands;
#   U6  `rollback`, `unhold` and `cleanup`;  U3  each recipe's line in `status`;
#   U2  the readers' own tests, and the `.local` name in `status` (no record holds the name the Mac had
#       when the household's devices were given the address).
#
# The commands (B6). Exit codes: 0 done; 1 refused; 2 usage; 3 not in this version (each a TODO); 4 the
# server is down. `start`, `restart`, `key add` and `key revoke` exit 0 when the server check passes and 4
# otherwise, naming `auster start` after open and `auster status` after not answered.
#   status                       what serves, the engine job's last start, the check job's last probe, why
#                                the engine is stopped, a job macOS has switched off, the devices, the sleep
#                                setting
#   stop                         launchctl disable, then bootout; builds/stopped says `household`
#   start                        enable, then bootstrap (kickstart -k if it is loaded); builds/stopped
#                                deleted, whatever the check then gives; the server check
#   restart                      kickstart -k; the server check
#   network                      the router the Mac's connection goes through now, into builds/mac (BD9)
#   verify                       every file serving names, against its sha256 (AD13)
#   people <n>                   the number checked, then TODO(U5)
#   key add|revoke|show <name>   B7, below
#   remove                       B8, and `install.sh remove`'s through the driver
#   update, rollback, unhold, cleanup   TODO(U4, U6)
# Each that stops or starts the engine or writes a record takes the lock. While builds/stopped exists,
# whatever it holds and whether or not it can be read, `update`, `people`, `restart`, `key add` and `key
# revoke` refuse and name `auster start`; `start`, `rollback`, `status`, `key show`, `verify`, `network`
# and `remove` work. A `stopped` of a newer format is left as it is: `start` and `stop` then refuse.
#
# Records written here (D3.1): the lock `builds/updating` (one line: `auster-record 1`, the process, the
# boot session, the process's start time); `builds/stopped` (one line: `auster-record 1`, `household` or
# `open`, and the time, `date -u +%Y-%m-%dT%H:%M:%SZ`); the speed in serving's launch line; the router in
# builds/mac (`auster network`, in capability-lib.js's form). And what the engine reads, which carries no
# format number (B7): each device's key in keys/<id> (32 hex characters and a newline, mode 0600), its name
# in keys/<id>.name (one line, AU_RE_DEVICE), Auster's own probe key in keys/probe, and keys/engine.keys:
# every named device's key in the order of their ids, then the probe key, one a line, mode 0600, written to
# a temporary file and renamed, and never written without a device key.
#
# The QR code (B7). AU_QR_JS, run by JavaScript for Automation, reads the key on its standard input (never
# its command line) and draws it with Core Image's CIQRCodeGenerator, correction level M, in half-block
# characters, black on white whatever the terminal's colours, with a quiet zone of four modules. It is drawn
# on the terminal's alternate screen (AU_SCREEN), never on standard output, which may be a log; the screen
# and the scrollback are erased once the person says the device has read it, or on an interrupt.
#
# The line in ~/.zprofile (B6): AU_ZPROFILE_LINE, a constant that names no path but $HOME's, added at the
# end on the household's yes and removed by `remove` where it is equal byte for byte, every other line as
# it was. A ~/.zprofile that is a link is never rewritten: the line is printed instead.
#
# Everything runs under /bin/bash 3.2 with what macOS ships (T98). Test variables: AU_TTY names a file
# that stands for the terminal the questions are read from (a test's answers, one a line); AU_SCREEN, the
# file that stands for the terminal the QR code is drawn on (/dev/tty otherwise); AU_SERVER_CHECK_SECS, a
# whole number of seconds from 1 to 999, replaces the server check's 180; AU_MINT, the id minter
# (tools/mint-id in the tree, which the driver names; jobs/mint-id in the data root, which step 3 copies).

AU_LABEL_ENGINE=local.auster.engine
AU_LABEL_CHECK=local.auster.check
AU_ROOT_MARKER=.auster-data-root
AU_CHECK_SECS=180                     # B3 step 13: the server check's limit from this run's start of the engine
AU_RE_RECIPE='^r[a-z2-7]{12}$'
AU_RE_BUILD='^b[a-z2-7]{12}$'
AU_RE_KEYID='^k[a-z2-7]{12}$'
AU_RE_KEY='^[0-9a-f]{32}$'
AU_RE_SHA='^[0-9a-f]{64}$'
AU_RE_PID='^[1-9][0-9]{0,9}$'
AU_RE_BOOT='^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
AU_RE_LSTART='^(Mon|Tue|Wed|Thu|Fri|Sat|Sun) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [ 123][0-9] [0-2][0-9]:[0-5][0-9]:[0-5][0-9] [0-9]{4}$'
AU_RE_SPEED='^(0|[1-9][0-9]{0,5})(\.[0-9]{1,3})?$'
AU_RE_IPV4='^(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})$'
AU_RE_DEVICE='^[a-z][a-z0-9-]{0,39}$'   # a device's name (B7): what the household calls it, never a path
AU_RE_UTC='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
AU_T=$'\t'
if [[ ${AU_SERVER_CHECK_SECS:-} =~ ^[1-9][0-9]{0,2}$ ]]; then AU_CHECK_SECS=$AU_SERVER_CHECK_SECS; fi   # a test's limit

# B6: the line the installer adds to ~/.zprofile on a yes, so that Terminal finds `auster`. Quoted, marked as
# Auster's, and the same on every Mac, so that `remove` takes out exactly it and nothing that resembles it.
AU_ZPROFILE_LINE='export PATH="$HOME/Library/Application Support/Auster/bin:$PATH"   # added by Auster; auster remove removes this line'

# B7: the QR code of the key on standard input (32 hex characters and a newline, nothing else), as lines of
# half-block characters, black on white, with a quiet zone of four modules (Core Image adds one). Pure ASCII.
AU_QR_JS='ObjC.import("AppKit");
ObjC.import("CoreImage");
function run() {
  var d = $.NSFileHandle.fileHandleWithStandardInput.readDataOfLength(34);
  var s = ObjC.unwrap($.NSString.alloc.initWithDataEncoding(d, $.NSASCIIStringEncoding));
  if (typeof s !== "string" || !/^[0-9a-f]{32}\n$/.test(s)) return "";
  var f = $.CIFilter.filterWithName("CIQRCodeGenerator");
  f.setValueForKey($(s.slice(0, 32)).dataUsingEncoding($.NSASCIIStringEncoding), "inputMessage");
  f.setValueForKey($("M"), "inputCorrectionLevel");
  var rep = $.NSBitmapImageRep.alloc.initWithCIImage(f.outputImage);
  var n = Number(rep.pixelsWide), g = $.NSColorSpace.genericGrayColorSpace, q = 3, m = [], out = [], x, y, r, l;
  if (!(n >= 21 && n <= 200) || n !== Number(rep.pixelsHigh)) return "";
  for (y = -q; y < n + q + 1; y++) {
    r = [];
    for (x = -q; x < n + q; x++) r.push(y >= 0 && y < n && x >= 0 && x < n && rep.colorAtXY(x, y).colorUsingColorSpace(g).whiteComponent < 0.5);
    m.push(r);
  }
  for (y = 0; y + 1 < m.length; y += 2) {
    l = "\u001b[38;5;16;48;5;231m";
    for (x = 0; x < m[y].length; x++) l += m[y][x] ? (m[y + 1][x] ? "\u2588" : "\u2580") : (m[y + 1][x] ? "\u2584" : " ");
    out.push(l + "\u001b[0m");
  }
  return out.join("\n");
}'

au_say() { printf '%s\n' "$*"; }

au_split() { # LINE -> array AU_F, split on single tabs, empty fields kept
  local rest=$1
  AU_F=()
  while :; do
    case "$rest" in
      *"$AU_T"*) AU_F+=("${rest%%"$AU_T"*}"); rest=${rest#*"$AU_T"} ;;
      *) AU_F+=("$rest"); break ;;
    esac
  done
}

au_trim() { # TEXT -> without leading and trailing blanks
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}; s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

au_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

au_sha() { # FILE -> its sha256, by openssl (B3 step 7), or nothing
  local out
  out=$(openssl dgst -sha256 "$1" 2>/dev/null) || return 1
  out=${out##*= }
  [[ $out =~ $AU_RE_SHA ]] || return 1
  printf '%s' "$out"
}

au_size() { stat -f %z "$1" 2>/dev/null; }

au_identity() { # -> AU_UID, AU_USER, AU_DATA, AU_BOOT, AU_SELF_START; prints why and returns 1 when any is unknown
  AU_UID=$(id -u 2>/dev/null)
  AU_USER=$(id -un 2>/dev/null)
  case "$AU_UID" in ''|*[!0-9]*) au_say "Auster cannot tell which account it runs as."; return 1 ;; esac
  if [ "$AU_UID" = 0 ]; then au_say "Auster does not run as root (with sudo): run it from your own account."; return 1; fi
  case "${HOME:-}" in /*) ;; *) au_say "Auster cannot tell where your home folder is."; return 1 ;; esac
  [ -d "$HOME" ] || { au_say "Your home folder is missing."; return 1; }
  AU_DATA="$HOME/Library/Application Support/Auster"
  AU_BOOT=$(sysctl -n kern.bootsessionuuid 2>/dev/null)
  [[ $AU_BOOT =~ $AU_RE_BOOT ]] || { au_say "Auster cannot read this Mac's boot session (sysctl kern.bootsessionuuid)."; return 1; }
  AU_SELF_START=$(au_trim "$(ps -p $$ -o lstart= 2>/dev/null)")
  [[ $AU_SELF_START =~ $AU_RE_LSTART ]] || { au_say "Auster cannot read its own start time (ps)."; return 1; }
}

# --- the data root (B1) and ownership (D3.1) -------------------------------------------------------

au_dir_ok() { # DIR -> 0 when DIR is a folder, not a link, owned by this account, that nobody else may write
  local s m
  [ -d "$1" ] && [ ! -L "$1" ] || return 1
  s=$(stat -f '%u %Lp' "$1" 2>/dev/null) || return 1
  [ "${s%% *}" = "$AU_UID" ] || return 1
  m=${s#* }; m=00$m; m=${m: -3}
  case "${m:1:1}${m:2:1}" in *[2367]*) return 1 ;; esac
}

au_root_check() { # DATA -> 0 when DATA is absent (AU_ROOT_NEW=1) or is Auster's data root, whole (AU_ROOT_NEW=0);
  # otherwise prints why and returns 1. Nothing is written either way.
  local d=$1 p sub
  for p in "$HOME/Library" "$HOME/Library/Application Support"; do
    if [ -L "$p" ]; then au_say "$p is a link; Auster writes nowhere that passes through a link."; return 1; fi
  done
  [ -d "$HOME/Library/Application Support" ] || { au_say "$HOME/Library/Application Support is missing."; return 1; }
  if [ -L "$d" ]; then
    au_say "$d is a link. Auster's data root must be a folder of its own; nothing was changed."
    return 1
  fi
  if [ ! -e "$d" ]; then AU_ROOT_NEW=1; return 0; fi
  AU_ROOT_NEW=0
  if ! au_dir_ok "$d" || [ "$(stat -f %Lp "$d" 2>/dev/null)" != 700 ]; then
    au_say "$d must be a folder of mode 0700 that only $AU_USER owns and can write; nothing was changed."
    return 1
  fi
  if [ ! -f "$d/$AU_ROOT_MARKER" ] || [ -L "$d/$AU_ROOT_MARKER" ]; then
    au_say "$d is not Auster's data root (it has no $AU_ROOT_MARKER); nothing was changed."
    return 1
  fi
  for sub in builds store engines keys logs bin jobs _update; do
    if [ -e "$d/$sub" ] || [ -L "$d/$sub" ]; then
      au_dir_ok "$d/$sub" || { au_say "$d/$sub must be a folder that only $AU_USER owns and can write; nothing was changed."; return 1; }
    fi
  done
  for sub in "$d"/builds/r*; do
    [ -e "$sub" ] || [ -L "$sub" ] || continue
    au_dir_ok "$sub" || { au_say "$sub must be a folder that only $AU_USER owns and can write; nothing was changed."; return 1; }
  done
}

au_mkdir() { # DIR -> a folder of mode 0700, made if absent; 1 if it cannot be, or is not ours
  if [ ! -e "$1" ] && [ ! -L "$1" ]; then mkdir -m 700 "$1" 2>/dev/null || return 1; fi
  au_dir_ok "$1"
}

au_put() { # SOURCE DEST MODE -> DEST holds SOURCE's bytes, written by rename; skipped when already equal
  if [ -f "$2" ] && [ ! -L "$2" ] && cmp -s "$1" "$2"; then chmod "$3" "$2"; return 0; fi
  local t="${2%/*}/.${2##*/}.new.$$"
  rm -f "$t"
  cp "$1" "$t" && chmod "$3" "$t" && mv -f "$t" "$2"
}

# --- the lock (D3.1, D3.6): builds/updating, read by its own reader ----------------------------------

au_record_first() { # FILE -> the first field of its first 4,096 bytes (D3.1 Reading: the format first)
  local line
  line=$(head -c 4096 "$1" 2>/dev/null | head -n 1)
  printf '%s' "${line%%"$AU_T"*}"
}

au_newer() { # FILE -> 0 when it is a record of a newer format than this version reads (D3.1, T95): its
  # first field says `auster-record <n>` or `auster-descriptor <n>` with n above 1, whatever else it holds
  local first n
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  first=$(au_record_first "$1")
  case "$first" in 'auster-record '*|'auster-descriptor '*) n=${first#* } ;; *) return 1 ;; esac
  [[ $n =~ ^[1-9][0-9]{0,8}$ ]] && [ "$n" -gt 1 ]
}

au_lock_read() { # FILE -> AU_LOCK: absent, newer, or held, with AU_LOCK_PID, AU_LOCK_BOOT, AU_LOCK_START.
  # A link, a folder, anything but `auster-record 1` with exactly four fields on one line of at most
  # 4,096 bytes is absent; `auster-record <n>` with a larger n is newer, whatever else it holds.
  local f=$1 first n line
  AU_LOCK=absent AU_LOCK_PID= AU_LOCK_BOOT= AU_LOCK_START=
  [ -f "$f" ] && [ ! -L "$f" ] || return 0
  first=$(au_record_first "$f")
  case "$first" in
    'auster-record 1') ;;
    'auster-record '*)
      n=${first#auster-record }
      [[ $n =~ ^[1-9][0-9]{0,8}$ ]] && [ "$n" -gt 1 ] && AU_LOCK=newer
      return 0 ;;
    *) return 0 ;;
  esac
  [ "$(au_size "$f")" -le 4096 ] || return 0
  [ "$(wc -l < "$f" | tr -d ' ')" = 1 ] && [ "$(tail -c 1 "$f" | od -An -tx1 | tr -d ' \n')" = 0a ] || return 0
  IFS= read -r line < "$f"
  au_split "$line"
  [ "${#AU_F[@]}" -eq 4 ] || return 0
  [[ ${AU_F[1]} =~ $AU_RE_PID ]] && [[ ${AU_F[2]} =~ $AU_RE_BOOT ]] && [[ ${AU_F[3]} =~ $AU_RE_LSTART ]] || return 0
  AU_LOCK=held AU_LOCK_PID=${AU_F[1]} AU_LOCK_BOOT=${AU_F[2]} AU_LOCK_START=${AU_F[3]}
}

au_alive() { # PID BOOT START -> 0 when that process, of this boot, is alive: all three must match (D3.1)
  local s
  [ "$2" = "$AU_BOOT" ] || return 1
  s=$(ps -p "$1" -o lstart= 2>/dev/null) || return 1
  s=$(au_trim "$s")
  [ -n "$s" ] && [ "$s" = "$3" ]
}

au_lock_take() { # -> 0 holding builds/updating (AU_LOCKED=1); prints why and returns 1 when a live run
  # holds it, or the record is a newer version's (left as it is). A lock whose process is gone, whose
  # number now belongs to another process, or from an earlier boot, is taken over.
  local f="$AU_DATA/builds/updating" t
  au_lock_read "$f"
  if [ "$AU_LOCK" = newer ]; then
    au_say "$f was written by a newer version of Auster, so this one leaves it as it is."
    au_say "Paste the installer line from the guide to update, or remove Auster with: \"$AU_DATA/bin/auster\" remove"
    return 1
  fi
  if [ "$AU_LOCK" = held ] && au_alive "$AU_LOCK_PID" "$AU_LOCK_BOOT" "$AU_LOCK_START"; then
    au_say "Another run of Auster (process $AU_LOCK_PID) is installing, updating or changing the server. Wait for it to end, then try again."
    return 1
  fi
  t="$AU_DATA/builds/.updating.$$"
  printf 'auster-record 1\t%s\t%s\t%s\n' "$$" "$AU_BOOT" "$AU_SELF_START" > "$t" || return 1
  if [ "$AU_LOCK" = absent ] && [ ! -e "$f" ] && [ ! -L "$f" ]; then
    if ! ln "$t" "$f" 2>/dev/null; then rm -f "$t"; au_say "Another run of Auster took the lock just now. Try again when it ends."; return 1; fi
    rm -f "$t"
  else
    mv -f "$t" "$f" || return 1
  fi
  au_lock_read "$f"
  if [ "$AU_LOCK" != held ] || [ "$AU_LOCK_PID" != "$$" ] || [ "$AU_LOCK_START" != "$AU_SELF_START" ]; then
    au_say "Another run of Auster took the lock just now. Try again when it ends."
    return 1
  fi
  AU_LOCKED=1
}

au_lock_release() { # -> builds/updating removed, when it is still this run's
  [ "${AU_LOCKED:-0}" = 1 ] || return 0
  local f="$AU_DATA/builds/updating"
  au_lock_read "$f"
  if [ "$AU_LOCK" = held ] && [ "$AU_LOCK_PID" = "$$" ] && [ "$AU_LOCK_START" = "$AU_SELF_START" ]; then rm -f "$f"; fi
  AU_LOCKED=0
}

# --- questions, from the terminal ---------------------------------------------------------------------

au_ask() { # PROMPT -> AU_REPLY, one line read from the terminal (or the file AU_TTY names); 1 at its end
  local tty=${AU_TTY:-/dev/tty}
  if [ "${AU_TTY_OPEN:-0}" != 1 ]; then
    ( exec 3< "$tty" ) 2>/dev/null || { au_say "Auster needs a terminal to ask its questions."; return 1; }
    exec 3< "$tty"
    AU_TTY_OPEN=1
  fi
  printf '%s ' "$1"
  AU_REPLY=
  IFS= read -r AU_REPLY <&3 || { printf '\n'; return 1; }
  [ -t 3 ] || printf '\n'   # a terminal ends the line itself when the answer is typed
  AU_REPLY=$(au_trim "$AU_REPLY")
}

au_yes() { # PROMPT -> 0 only on the answer yes; asked again, at most five times, for anything but yes or no
  local i
  for i in 1 2 3 4 5; do
    au_ask "$1 [yes/no]" || return 1
    case "$AU_REPLY" in yes|YES|Yes) return 0 ;; no|NO|No) return 1 ;; esac
    au_say "Please type yes or no."
  done
  return 1
}

# --- the jobs (B4, B5) ----------------------------------------------------------------------------------

au_job_file() { printf '%s' "$HOME/Library/LaunchAgents/$1.plist"; }

au_job_loaded() { launchctl print "gui/$AU_UID/$1" > /dev/null 2>&1; }

au_job_load() { # LABEL -> enabled, then bootstrapped (B3 step 12, as `auster start` does); 0 when loaded after
  au_job_loaded "$1" && return 0
  launchctl enable "gui/$AU_UID/$1" || return 1
  launchctl bootstrap "gui/$AU_UID" "$(au_job_file "$1")" || return 1
}

au_engine_stop() { # -> the engine stopped so that it stays stopped across logins: disable, then bootout
  launchctl disable "gui/$AU_UID/$AU_LABEL_ENGINE"
  au_job_loaded "$AU_LABEL_ENGINE" && launchctl bootout "gui/$AU_UID/$AU_LABEL_ENGINE"
  return 0
}

# --- records the server check reads and writes --------------------------------------------------------

au_serving_read() { # RECIPE -> AU_SV_* from builds/<recipe>/serving (A5), or 1 when it cannot be read.
  # TODO(U2): the descriptor's own reader, with a bound and one pattern for every field.
  local f="$AU_DATA/builds/$1/serving" n=0 l
  AU_SV_LINES=()
  [ -f "$f" ] && [ ! -L "$f" ] && [ "$(au_size "$f")" -le 8192 ] || return 1
  while IFS= read -r l; do AU_SV_LINES+=("$l"); n=$((n + 1)); done < "$f"
  [ "$n" -eq 5 ] && [ "${AU_SV_LINES[0]}" = 'auster-descriptor 1' ] || return 1
  au_split "${AU_SV_LINES[1]}"; [ "${AU_F[0]}" = build ] && [ "${#AU_F[@]}" -ge 14 ] || return 1
  AU_SV_BUILD=${AU_F[1]} AU_SV_TEST=${AU_F[6]} AU_SV_TEMPLATE=${AU_F[4]} AU_SV_SYSTEM=${AU_F[5]}
  [[ $AU_SV_BUILD =~ $AU_RE_BUILD ]] && [[ $AU_SV_TEST =~ $AU_RE_SHA ]] || return 1
  [[ $AU_SV_TEMPLATE =~ $AU_RE_SHA ]] && [[ $AU_SV_SYSTEM =~ $AU_RE_SHA ]] || return 1
  au_split "${AU_SV_LINES[2]}"; [ "${AU_F[0]}" = engine ] && [ "${#AU_F[@]}" -ge 8 ] || return 1
  AU_SV_ENGINE=${AU_F[6]}
  au_split "${AU_SV_LINES[3]}"; [ "${AU_F[0]}" = model ] && [ "${#AU_F[@]}" -ge 10 ] || return 1
  AU_SV_MODEL=${AU_F[6]} AU_SV_MODEL_FILE=${AU_F[4]}
  [[ $AU_SV_ENGINE =~ $AU_RE_SHA ]] && [[ $AU_SV_MODEL =~ $AU_RE_SHA ]] || return 1
  au_split "${AU_SV_LINES[4]}"
  [ "${#AU_F[@]}" -eq 6 ] && [ "${AU_F[0]}" = launch ] || return 1
  AU_SV_PEOPLE=${AU_F[1]} AU_SV_CONTEXT=${AU_F[2]} AU_SV_PORT=${AU_F[3]} AU_SV_LIST=${AU_F[4]} AU_SV_SPEED=${AU_F[5]}
  [[ $AU_SV_PORT =~ ^[1-9][0-9]{0,4}$ ]] && [[ $AU_SV_LIST =~ $AU_RE_SHA ]] && [[ $AU_SV_SPEED =~ $AU_RE_SPEED ]] || return 1
}

au_serving_speed() { # RECIPE SPEED -> serving with that speed in its launch line, replaced by rename (A5)
  local f="$AU_DATA/builds/$1/serving" t
  au_serving_read "$1" || return 1
  t="$AU_DATA/builds/$1/.serving.new.$$"
  { printf '%s\n' "${AU_SV_LINES[0]}" "${AU_SV_LINES[1]}" "${AU_SV_LINES[2]}" "${AU_SV_LINES[3]}"
    printf 'launch\t%s\t%s\t%s\t%s\t%s\n' "$AU_SV_PEOPLE" "$AU_SV_CONTEXT" "$AU_SV_PORT" "$AU_SV_LIST" "$2"; } > "$t" &&
    chmod 600 "$t" && mv -f "$t" "$f"
}

au_start_read() { # RECIPE -> AU_ST_CODE, AU_ST_ADDR, AU_ST_TIME from builds/<recipe>/start, written by the
  # engine job (B4 step 6), or 1. Its form: `auster-record 1`, then code, address, boot and time lines,
  # each a key, a tab and a value (the address - when the job stopped before it found one).
  # The engine job (common/auster-engine, V6) writes it in this form. TODO(U2): its reader's own tests.
  local f="$AU_DATA/builds/$1/start" l n=0 k v
  AU_ST_CODE= AU_ST_ADDR= AU_ST_TIME=
  [ -f "$f" ] && [ ! -L "$f" ] && [ "$(au_size "$f")" -le 1024 ] || return 1
  while IFS= read -r l; do
    n=$((n + 1))
    if [ "$n" = 1 ]; then [ "$l" = 'auster-record 1' ] || return 1; continue; fi
    k=${l%%"$AU_T"*}; v=${l#*"$AU_T"}
    case "$n:$k" in
      2:code) [[ $v =~ ^(starting|keys|engine-hash|not-home|no-network)$ ]] && AU_ST_CODE=$v ;;
      3:address) { [ "$v" = - ] || [[ $v =~ $AU_RE_IPV4 ]]; } && AU_ST_ADDR=$v ;;
      4:boot) [[ $v =~ $AU_RE_BOOT ]] || return 1 ;;
      5:time) [[ $v =~ ^[1-9][0-9]{0,11}$ ]] && AU_ST_TIME=$v ;;
      *) return 1 ;;
    esac
  done < "$f"
  [ "$n" = 5 ] && [ -n "$AU_ST_CODE" ] && [ -n "$AU_ST_ADDR" ] && [ -n "$AU_ST_TIME" ]
}

au_stopped_write() { # REASON -> builds/stopped (D3.1), by rename
  local t="$AU_DATA/builds/.stopped.new.$$"
  printf 'auster-record 1\t%s\t%s\n' "$1" "$(au_now)" > "$t" && mv -f "$t" "$AU_DATA/builds/stopped"
}

au_speed_request() { # TEST-FILE OUT [TOKENS] -> the speed question (A5) as a request body, from the recipe's
  # test file; with TOKENS, the same question asking for that many tokens (the request with no key asks for 1)
  osascript -l JavaScript -e '
function run(a) {
  var d = $.NSData.dataWithContentsOfFile(a[0]);
  if (d.isNil()) return "";
  var t = JSON.parse(ObjC.unwrap($.NSString.alloc.initWithDataEncoding(d, $.NSUTF8StringEncoding)));
  var s = t.speed;
  if (!s || typeof s.q !== "string" || s.temperature !== 0 || s.max_tokens !== Math.floor(s.max_tokens) ||
      s.max_tokens < 1 || s.max_tokens > 32768) return "";
  var n = a.length > 1 ? Number(a[1]) : s.max_tokens;
  return JSON.stringify({ messages: [{ role: "user", content: s.q }], max_tokens: n, temperature: 0 });
}' "$1" ${3:+"$3"} > "$2" 2>/dev/null && [ -s "$2" ]
}

au_rate() { # ANSWER-FILE -> the writing rate it reports (timings.predicted_per_second), as A5 keeps it
  local r w f
  r=$(plutil -extract timings.predicted_per_second raw -o - "$1" 2>/dev/null) || return 1
  [[ $r =~ ^[0-9]{1,6}(\.[0-9]+)?$ ]] || return 1
  w=${r%%.*} f=
  case "$r" in *.*) f=${r#*.}; f=${f:0:3}; while [ -n "$f" ] && [ "${f: -1}" = 0 ]; do f=${f%0}; done ;; esac
  w=$((10#$w))
  if [ -n "$f" ]; then r="$w.$f"; else r=$w; fi
  [ "$r" != 0 ] && [[ $r =~ $AU_RE_SPEED ]] || return 1
  printf '%s' "$r"
}

au_server_check() { # RECIPE T0 [KEYFILE] -> AU_CHECK: passed, open or unanswered (B3 step 13). Never exits.
  # From this Mac to its home address, within 180 s of T0 (this run's start of the engine), the speed
  # question with a household key (KEYFILE's, when given: `auster key add` asks with the new one) must be
  # answered; only then must a request with no key be refused.
  # Refused is HTTP 401 or 403 and nothing else: that request asks for one token, so that an open server
  # answers it at once, and any other code, a time-out or no answer is open (it fails closed; V6). Its
  # limit is what is left of the 180 s, at least 5 s and at most 30 s.
  # passed writes the speed into serving when it holds 0; open stops the engine (disable, then bootout)
  # and writes builds/stopped with the reason open; unanswered does nothing. AU_CHECK_WHY says why.
  local r=$1 t0=$2 w key= kf now i=0 code left
  AU_CHECK=unanswered AU_CHECK_WHY= AU_CHECK_SPEED=
  au_serving_read "$r" || { AU_CHECK_WHY="its descriptor cannot be read"; return 0; }
  for kf in ${3:+"$3"} "$AU_DATA"/keys/k*; do
    case "${kf##*/}" in *.*) continue ;; esac
    [ -f "$kf" ] && [ ! -L "$kf" ] || continue
    IFS= read -r key < "$kf" && [[ $key =~ $AU_RE_KEY ]] && break
    key=
  done
  [ -n "${key:-}" ] || { AU_CHECK_WHY="no household key could be read"; return 0; }
  w=$(mktemp -d "${TMPDIR:-/tmp}/auster-check.XXXXXX") || { AU_CHECK_WHY="no temporary folder"; return 0; }
  ( umask 077; printf 'Authorization: Bearer %s\n' "$key" > "$w/key" )
  au_speed_request "$AU_DATA/store/$AU_SV_TEST" "$w/body" && au_speed_request "$AU_DATA/store/$AU_SV_TEST" "$w/nokey" 1 ||
    { rm -rf "$w"; AU_CHECK_WHY="the recipe's test file cannot be read"; return 0; }
  while :; do
    now=$(date +%s)
    left=$((t0 + AU_CHECK_SECS - now))
    [ "$left" -gt 0 ] && [ "$i" -le "$AU_CHECK_SECS" ] || break
    if au_start_read "$r" && [ "$AU_ST_TIME" -ge "$t0" ] && [ "$AU_ST_CODE" = starting ]; then
      code=$(curl -q -sS --max-time "$left" -o "$w/answer" -w '%{http_code}' -H @"$w/key" \
        -H 'Content-Type: application/json' --data-binary @"$w/body" \
        "http://$AU_ST_ADDR:$AU_SV_PORT/v1/chat/completions" 2>/dev/null)
      if [ "$code" = 200 ] && AU_CHECK_SPEED=$(au_rate "$w/answer"); then break; fi
      AU_CHECK_SPEED=
    fi
    sleep 1
    i=$((i + 1))
  done
  if [ -z "$AU_CHECK_SPEED" ]; then
    rm -rf "$w"
    if au_start_read "$r" && [ "$AU_ST_TIME" -ge "$t0" ]; then
      AU_CHECK_WHY="the engine job's last start says $AU_ST_CODE"
    else
      AU_CHECK_WHY="the engine job has not run since this run started it"
    fi
    return 0
  fi
  left=$((t0 + AU_CHECK_SECS - $(date +%s)))
  [ "$left" -le 30 ] || left=30
  [ "$left" -ge 5 ] || left=5
  code=$(curl -q -sS --max-time "$left" -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' \
    --data-binary @"$w/nokey" "http://$AU_ST_ADDR:$AU_SV_PORT/v1/chat/completions" 2>/dev/null)
  rm -rf "$w"
  if [ "$code" != 401 ] && [ "$code" != 403 ]; then
    au_engine_stop
    au_stopped_write open
    AU_CHECK=open AU_CHECK_WHY="it did not refuse a request that carried no key (it gave ${code:-no answer})"
    return 0
  fi
  [ "$AU_SV_SPEED" = 0 ] && au_serving_speed "$r" "$AU_CHECK_SPEED"
  AU_CHECK=passed
}


# --- the engine's list of files (B3 step 9), shared with the driver -------------------------------------

au_list() { # ROOT -> the engine's file list (B3 step 9): `path TAB size TAB sha256` for each file and
  # `path TAB link TAB target` for each link, sorted by path; the engine job makes it again at each start
  (cd "$1" && find . \( -type f -o -type l \) -print | sed 's|^\./||' | LC_ALL=C sort | while IFS= read -r p; do
    if [ -L "$p" ]; then printf '%s\tlink\t%s\n' "$p" "$(readlink "$p")"
    else printf '%s\t%s\t%s\n' "$p" "$(stat -f %z "$p")" "$(au_sha "$p")"; fi
  done)
}

# --- what serves, `stopped`, and the engine's starts (B6) ------------------------------------------------

au_ready() { # -> 0 when Auster is installed here and serves, with AU_RECIPE the recipe it serves (BD14: one);
  # otherwise says why and returns 1
  local s r
  au_root_check "$AU_DATA" || return 1
  if [ "$AU_ROOT_NEW" = 1 ]; then au_say "Auster is not installed on this Mac."; return 1; fi
  AU_RECIPE=
  for s in "$AU_DATA"/builds/r*/serving; do
    r=${s%/serving}; r=${r##*/}
    if [[ $r =~ $AU_RE_RECIPE ]] && [ -f "$s" ] && [ ! -L "$s" ]; then AU_RECIPE=$r; break; fi
  done
  [ -n "$AU_RECIPE" ] && return 0
  au_say "Nothing serves on this Mac yet: its install stopped before its server. Paste the installer line again to go on, or remove it with: \"$AU_DATA/bin/auster\" remove"
  return 1
}

au_say_newer() { # FILE -> how to update or remove, for a record of a newer format, which is left as it is (D3.1, T95)
  au_say "$1 was written by a newer version of Auster, so this one leaves it as it is."
  au_say "Paste the installer line from the guide to update, or remove Auster with: \"$AU_DATA/bin/auster\" remove"
}

au_stopped_read() { # -> AU_STOPPED: no, yes or newer, from builds/stopped (D3.1), with AU_STOPPED_WHY (household, open
  # or unknown) and AU_STOPPED_AT. One line of at most 4,096 bytes: `auster-record 1`, the reason, the time. A
  # stopped that exists but cannot be read, a link or a folder among them, means stopped for a reason unknown;
  # it is never taken as absent
  local f="$AU_DATA/builds/stopped" line
  AU_STOPPED=no AU_STOPPED_WHY= AU_STOPPED_AT=
  [ -e "$f" ] || [ -L "$f" ] || return 0
  AU_STOPPED=yes AU_STOPPED_WHY=unknown
  if au_newer "$f"; then AU_STOPPED=newer; return 0; fi
  [ -f "$f" ] && [ ! -L "$f" ] && [ "$(au_record_first "$f")" = 'auster-record 1' ] || return 0
  [ "$(au_size "$f")" -le 4096 ] && [ "$(wc -l < "$f" | tr -d ' ')" = 1 ] &&
    [ "$(tail -c 1 "$f" | od -An -tx1 | tr -d ' \n')" = 0a ] || return 0
  IFS= read -r line < "$f" || return 0
  au_split "$line"
  [ "${#AU_F[@]}" -eq 3 ] && [[ ${AU_F[1]} =~ ^(household|open)$ ]] && [[ ${AU_F[2]} =~ $AU_RE_UTC ]] || return 0
  AU_STOPPED_WHY=${AU_F[1]} AU_STOPPED_AT=${AU_F[2]}
}

au_refuse_stopped() { # -> 0 when builds/stopped does not exist; otherwise says so, names `auster start`, and returns 1
  # (B6: whatever it holds, and whether or not it can be read)
  au_stopped_read
  [ "$AU_STOPPED" = no ] && return 0
  case "$AU_STOPPED_WHY" in
    household) au_say "Auster's server is stopped: the household stopped it (auster stop)." ;;
    open) au_say "Auster's server is stopped: Auster stopped it, because it answered a request that carried no key." ;;
    *) au_say "Auster's server is stopped." ;;
  esac
  au_say "Nothing is done while it is stopped. \`auster start\` starts it, and checks it."
  return 1
}

au_engine_start() { # -> AU_T0, then the engine's job enabled and loaded (B6: enable, then bootstrap; kickstart -k
  # when it is loaded already, so that the server check sees a start of this run); 1 when launchd did not
  AU_T0=$(date +%s)
  launchctl enable "gui/$AU_UID/$AU_LABEL_ENGINE" > /dev/null 2>&1 || return 1
  if au_job_loaded "$AU_LABEL_ENGINE"; then
    launchctl kickstart -k "gui/$AU_UID/$AU_LABEL_ENGINE" > /dev/null 2>&1
  else
    launchctl bootstrap "gui/$AU_UID" "$(au_job_file "$AU_LABEL_ENGINE")" > /dev/null 2>&1
  fi
}

au_engine_restart() { # -> AU_T0, then kickstart -k (B6); says why and returns 1 when the engine's job is not loaded
  AU_T0=$(date +%s)
  if au_job_loaded "$AU_LABEL_ENGINE" && launchctl kickstart -k "gui/$AU_UID/$AU_LABEL_ENGINE" > /dev/null 2>&1; then
    return 0
  fi
  au_say "launchd has not loaded Auster's engine job, so it was not restarted. \`auster status\` says why."
  return 1
}

au_checked() { # [KEYFILE] -> the server check (B3 step 13) after this run's start of the engine, said in plain
  # words: 0 when it passed; 4 after open (Auster has stopped the engine) and after not answered (B6)
  au_server_check "$AU_RECIPE" "$AU_T0" ${1:+"$1"}
  case "$AU_CHECK" in
    passed)
      au_say "The server answered, at $AU_CHECK_SPEED tokens a second, and refused a request with no key."
      return 0 ;;
    open)
      au_say "The server did not refuse a request that carried no key, so Auster stopped it: $AU_CHECK_WHY."
      au_say "It stays stopped until \`auster start\`, which starts it and checks it again."
      return 4 ;;
  esac
  au_say "The server did not answer its check within $AU_CHECK_SECS s: $AU_CHECK_WHY."
  au_say "\`auster status\` says how the engine's last start went."
  return 4
}

# --- stop, start, restart, network, verify, people (B6) --------------------------------------------------

au_cmd_stop() { # -> the engine stopped so that it stays stopped across logins (disable, then bootout), and
  # builds/stopped saying `household`; a stop already recorded keeps its reason
  au_ready || return 1
  au_lock_take || return 1
  au_stopped_read
  if [ "$AU_STOPPED" = newer ]; then au_say_newer "$AU_DATA/builds/stopped"; return 1; fi
  au_engine_stop
  if [ "$AU_STOPPED" = no ] && ! au_stopped_write household; then
    au_say "The engine is stopped, but builds/stopped could not be written."
    return 1
  fi
  au_say "Auster's server is stopped, and stays stopped across logins and restarts until \`auster start\`."
}

au_cmd_start() { # -> the engine's job enabled and loaded, builds/stopped deleted whatever the check then gives, and
  # the server check, which writes builds/stopped again if the server is open: 0 or 4
  au_ready || return 1
  au_lock_take || return 1
  au_stopped_read
  if [ "$AU_STOPPED" = newer ]; then au_say_newer "$AU_DATA/builds/stopped"; return 1; fi
  if ! au_engine_start; then
    au_say "launchd did not start Auster's engine job, so it stays as it was. \`auster status\` says why."
    return 4
  fi
  rm -rf "$AU_DATA/builds/stopped"
  au_say "Auster's server is starting. Checking it on the home network..."
  au_checked
}

au_cmd_restart() { # -> kickstart -k, then the server check: 0 or 4
  au_ready || return 1
  au_lock_take || return 1
  au_refuse_stopped || return 1
  au_engine_restart || return 4
  au_say "Auster's server is restarting. Checking it on the home network..."
  au_checked
}

au_router_now() { # -> AU_NET_ROUTER and AU_NET_ADDR: the router and the address of the network this Mac is on now,
  # when it is one Auster serves on (BD9, B4 step 5: a hardware port, a private address); otherwise AU_NET_WHY
  # says why, and 1
  local r if_ gw hw p parts=()
  AU_NET_ROUTER= AU_NET_ADDR= AU_NET_WHY=
  r=$(route -n get default 2>/dev/null) || { AU_NET_WHY="This Mac has no network connection now, so no home network was recorded."; return 1; }
  if_=$(printf '%s\n' "$r" | awk '$1 == "interface:" { print $2; exit }')
  gw=$(printf '%s\n' "$r" | awk '$1 == "gateway:" { print $2; exit }')
  if ! [[ $if_ =~ ^[a-z][a-z0-9]{0,15}$ ]] || ! [[ $gw =~ $AU_RE_IPV4 ]]; then
    AU_NET_WHY="This Mac's connection does not go through a router Auster can see, so nothing was recorded."; return 1
  fi
  if ! networksetup -listallhardwareports 2>/dev/null | grep -qxF "Device: $if_"; then
    AU_NET_WHY="This Mac's connection goes through $if_, which is not a Wi-Fi or wired port (a VPN?), so nothing was recorded."; return 1
  fi
  AU_NET_ADDR=$(ipconfig getifaddr "$if_" 2>/dev/null)
  case "$AU_NET_ADDR" in
    10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) [[ $AU_NET_ADDR =~ $AU_RE_IPV4 ]] || AU_NET_ADDR= ;;
    *) AU_NET_ADDR= ;;
  esac
  [ -n "$AU_NET_ADDR" ] || { AU_NET_WHY="This Mac's address on $if_ is not a home network's (a private address), so nothing was recorded."; return 1; }
  hw=$(arp -n "$gw" 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "at") { print $(i + 1); exit } }')
  IFS=: read -r -a parts <<< "$hw"
  AU_NET_WHY="This Mac cannot see its router's hardware address, so nothing was recorded."
  [ "${#parts[@]}" -eq 6 ] || return 1
  for p in "${parts[@]}"; do
    [[ $p =~ ^[0-9a-fA-F]{1,2}$ ]] || { AU_NET_ROUTER=; return 1; }
    p=0$p
    AU_NET_ROUTER+=${AU_NET_ROUTER:+:}$(printf '%s' "${p: -2}" | tr 'A-F' 'a-f')
  done
  AU_NET_WHY=
}

au_cmd_network() { # -> BD9: the router this Mac's connection goes through now, recorded in builds/mac as the home
  # network, every other line of the record as it was, by rename. The engine job reads it at its next start
  local f="$AU_DATA/builds/mac" t="$AU_DATA/builds/.mac.new.$$" l n=0 lines=()
  au_ready || return 1
  au_lock_take || return 1
  if au_newer "$f"; then au_say_newer "$f"; return 1; fi
  au_router_now || { au_say "$AU_NET_WHY"; return 1; }
  if [ -f "$f" ] && [ ! -L "$f" ] && [ "$(au_size "$f")" -le 1024 ] && [ "$(tail -c 1 "$f" | od -An -tx1 | tr -d ' \n')" = 0a ]; then
    while IFS= read -r l; do lines+=("$l"); n=$((n + 1)); done < "$f"
  fi
  if [ "$n" != 7 ] || [ "${lines[0]}" != 'auster-record 1' ] || [ "${lines[5]%%"$AU_T"*}" != router ]; then
    au_say "This Mac's figures (builds/mac) cannot be read, so the home network was not recorded. Paste the installer line again."
    return 1
  fi
  lines[5]="router$AU_T$AU_NET_ROUTER"
  rm -f "$t"
  { printf '%s\n' "${lines[@]}"; } > "$t" && chmod 600 "$t" && mv -f "$t" "$f" ||
    { rm -f "$t"; au_say "builds/mac could not be written, so the home network was not recorded."; return 1; }
  au_say "The home network is now the one whose router is $AU_NET_ROUTER, where this Mac is $AU_NET_ADDR."
  au_say "The engine listens on it from its next start: \`auster restart\` moves it there now."
}

au_cmd_verify() { # -> AD13: every file serving names, against its sha256: the model, the engine's archive and its
  # unpacked files (against their list, whose sha256 the launch line holds), the template, the system prompt and
  # the recipe's test. 0 when all match; 1, naming each one that does not, otherwise
  local bad=0 what sha f out
  au_ready || return 1
  au_serving_read "$AU_RECIPE" || { au_say "The record of what serves cannot be read, so nothing was checked."; return 1; }
  au_say "Checking every file the server uses against its sha256..."
  for what in "model:$AU_SV_MODEL" "engine archive:$AU_SV_ENGINE" "template:$AU_SV_TEMPLATE" \
      "system prompt:$AU_SV_SYSTEM" "recipe's test:$AU_SV_TEST"; do
    sha=${what##*:} f="$AU_DATA/store/${what##*:}"
    if [ -f "$f" ] && [ ! -L "$f" ] && [ "$(au_sha "$f")" = "$sha" ]; then au_say "  same      the ${what%:*}"
    else au_say "  CHANGED   the ${what%:*} (store/$sha)"; bad=1; fi
  done
  f="$AU_DATA/engines/$AU_SV_ENGINE/root"
  out=
  if [ -d "$f" ] && [ ! -L "$f" ]; then out=$(au_list "$f" | openssl dgst -sha256 2>/dev/null); out=${out##*= }; fi
  if [ "$out" = "$AU_SV_LIST" ]; then au_say "  same      the engine's unpacked files"
  else au_say "  CHANGED   the engine's unpacked files (engines/$AU_SV_ENGINE)"; bad=1; fi
  if [ "$bad" = 0 ]; then au_say "Every file is the one the registry names."; return 0; fi
  au_say "A file has changed since it was checked. Paste the installer line again to fetch it again."
  return 1
}

au_cmd_people() { # N -> C4, B6: refused while stopped. TODO(U5): the change of setting itself, the update's procedure
  # for the build served with the recipe's limits from the fetched tree (1 to its default), then the check
  au_ready || return 1
  au_lock_take || return 1
  au_refuse_stopped || return 1
  au_say "Changing the number of people comes with a later version of Auster (U5); nothing was changed."
  return 3
}

au_cmd_later() { # COMMAND -> 3: a command of B6 that comes with a later version; `update` refuses while stopped first
  if [ "$1" = update ]; then
    au_ready || return 1
    au_refuse_stopped || return 1
    au_say "auster update comes with a later version of Auster (U4); nothing was changed."   # TODO(U4)
    return 3
  fi
  au_say "auster $1 comes with a later version of Auster (U6); nothing was changed."   # TODO(U6): rollback, unhold, cleanup
  return 3
}

# --- keys and the QR code (B7) ---------------------------------------------------------------------------

au_name_ok() { # NAME -> 0 when it is a name Auster gives a device (AU_RE_DEVICE); otherwise says so, without echoing
  # it. A name is never part of a path: a device's files are found by reading every keys/<id>.name
  [[ $1 =~ $AU_RE_DEVICE ]] && return 0
  au_say "That is not a name Auster gives a device: lower-case letters, digits and -, starting with a letter, at most 40 (such as ipad)."
  return 1
}

au_key_list() { # -> AU_KEY_IDS and AU_KEY_NAMES: every device, in the order of their ids. A device is keys/<id>, a
  # regular file holding one key and its newline, with its name in keys/<id>.name; a key with no name is no device's
  local f id n k
  AU_KEY_IDS=() AU_KEY_NAMES=()
  for f in "$AU_DATA"/keys/k*.name; do
    id=${f##*/}; id=${id%.name}
    [[ $id =~ $AU_RE_KEYID ]] && [ -f "$f" ] && [ ! -L "$f" ] && [ -f "$AU_DATA/keys/$id" ] && [ ! -L "$AU_DATA/keys/$id" ] || continue
    [ "$(au_size "$f")" -le 64 ] && [ "$(au_size "$AU_DATA/keys/$id")" = 33 ] || continue
    IFS= read -r n < "$f" && [[ $n =~ $AU_RE_DEVICE ]] || continue
    IFS= read -r k < "$AU_DATA/keys/$id" && [[ $k =~ $AU_RE_KEY ]] || continue
    AU_KEY_IDS+=("$id")
    AU_KEY_NAMES+=("$n")
  done
}

au_key_find() { # NAME -> AU_KEY_ID, the device of that name (and AU_KEY_IDS, AU_KEY_NAMES); 1 when none has it
  local i
  AU_KEY_ID=
  au_key_list
  for ((i = 0; i < ${#AU_KEY_IDS[@]}; i++)); do
    if [ "${AU_KEY_NAMES[$i]}" = "$1" ]; then AU_KEY_ID=${AU_KEY_IDS[$i]}; return 0; fi
  done
  return 1
}

au_key_new() { # FILE -> a new key in FILE: 32 hex characters from `openssl rand -hex 16` and a newline, mode 0600, by
  # rename (B7). The key passes through no command line and no file but its own
  local k t="${1%/*}/.${1##*/}.new.$$"
  k=$(openssl rand -hex 16 2>/dev/null)
  [[ $k =~ $AU_RE_KEY ]] || return 1
  rm -f "$t"
  ( umask 077; printf '%s\n' "$k" > "$t" ) && mv -f "$t" "$1"
}

au_key_unique() { # FILE -> 0 when its key equals no other key in keys/ (B7: two keys are never equal)
  local f k mine
  IFS= read -r mine < "$1" || return 1
  for f in "$AU_DATA"/keys/k* "$AU_DATA/keys/probe"; do
    case "${f##*/}" in *.*) continue ;; esac
    [ "$f" != "$1" ] && [ -f "$f" ] && [ ! -L "$f" ] || continue
    if IFS= read -r k < "$f" && [ "$k" = "$mine" ]; then return 1; fi
  done
}

au_key_mint() { # NAME -> AU_KEY_ID: a new device, its key in keys/<id> and its name in keys/<id>.name, each mode 0600
  # and written by rename; the id minted (A2), the key never derived from the name. 1, leaving nothing, otherwise
  local id t
  AU_KEY_ID=
  id=$(/bin/bash "${AU_MINT:-$AU_DATA/jobs/mint-id}" k 2>/dev/null)
  [[ $id =~ $AU_RE_KEYID ]] && [ ! -e "$AU_DATA/keys/$id" ] && [ ! -e "$AU_DATA/keys/$id.name" ] || return 1
  au_key_new "$AU_DATA/keys/$id" && au_key_unique "$AU_DATA/keys/$id" || { rm -f "$AU_DATA/keys/$id"; return 1; }
  t="$AU_DATA/keys/.$id.name.new.$$"
  rm -f "$t"
  ( umask 077; printf '%s\n' "$1" > "$t" ) && mv -f "$t" "$AU_DATA/keys/$id.name" || { rm -f "$t" "$AU_DATA/keys/$id"; return 1; }
  AU_KEY_ID=$id
}

au_keys_write() { # [EXCEPT-ID] -> keys/engine.keys (B7): every device's key but EXCEPT's, in the order of their ids,
  # then Auster's own probe key, one a line; written to a temporary file and renamed, never in place, then checked
  # as the engine job checks it (B4 step 3). 1, leaving the file as it was, when no device's key would be in it:
  # the engine reads a key file with no key in it as no key required (docs/phase-1.md, step 12)
  local f="$AU_DATA/keys/engine.keys" t="$AU_DATA/keys/.engine.keys.new.$$" i k n=0
  au_key_list
  rm -f "$t"
  ( umask 077; : > "$t" ) || return 1
  for ((i = 0; i < ${#AU_KEY_IDS[@]}; i++)); do
    [ "${AU_KEY_IDS[$i]}" != "${1:-}" ] || continue
    IFS= read -r k < "$AU_DATA/keys/${AU_KEY_IDS[$i]}" && printf '%s\n' "$k" >> "$t" && n=$((n + 1))
  done
  if [ "$n" -lt 1 ] || [ "$n" -gt 63 ] || [ ! -f "$AU_DATA/keys/probe" ] || [ -L "$AU_DATA/keys/probe" ] ||
     ! { IFS= read -r k < "$AU_DATA/keys/probe" && [[ $k =~ $AU_RE_KEY ]] && printf '%s\n' "$k" >> "$t"; }; then
    rm -f "$t"
    return 1
  fi
  n=$((n + 1))
  mv -f "$t" "$f" || { rm -f "$t"; return 1; }
  [ -f "$f" ] && [ ! -L "$f" ] && [ "$(stat -f '%u %Lp' "$f" 2>/dev/null)" = "$AU_UID 600" ] &&
    [ "$(au_size "$f")" = $((n * 33)) ] && [ "$(grep -c -v -E "$AU_RE_KEY" "$f")" = 0 ]
}

au_qr_leave() { # -> the QR code's screen erased and left, then the scrollback erased (B7); once
  [ "${AU_QR_ON:-0}" = 1 ] || return 0
  AU_QR_ON=0
  printf '\033[H\033[2J\033[?1049l\033[3J' >> "${AU_SCREEN:-/dev/tty}" 2>/dev/null
}

au_qr_show() { # NAME ID -> keys/<id>'s key as a QR code on the terminal's alternate screen, until the person says
  # that NAME has read it (B7). The key reaches the drawing program on its standard input, never its command
  # line; the drawing goes to the terminal (AU_SCREEN) and nowhere else. 1, showing nothing, when there is no
  # terminal or the code cannot be drawn
  local scr=${AU_SCREEN:-/dev/tty} qr
  if ! { : >> "$scr"; } 2>/dev/null; then
    au_say "There is no terminal here to show the key for $1 on. In Terminal, \`auster key show $1\` shows it."
    return 1
  fi
  qr=$(osascript -l JavaScript -e "$AU_QR_JS" < "$AU_DATA/keys/$2" 2>/dev/null)
  if [ -z "$qr" ]; then au_say "The QR code for $1 could not be drawn. \`auster key show $1\` tries again."; return 1; fi
  AU_QR_ON=1   # from here an exit erases it too (the EXIT traps of bin/auster and the driver call au_qr_leave)
  { printf '\033[?1049h\033[H\033[2J'
    printf '%s\n' "The key for $1. Open the camera on $1, point it at this code, and copy the text it reads into" \
      "the chat page's settings, as its API key." "" "$qr" ""; } >> "$scr"
  au_ask "Press Return when $1 has read it, and this screen is erased." >> "$scr"
  au_qr_leave
  au_say "The key for $1 was shown, and the screen it was on is erased."
}

au_cmd_key_add() { # NAME -> a new device's key, the engine's key file written again, the engine restarted and the
  # server check made with the new key; the key shown only after a passed check (`key show` gives it later): 0 or 4
  local name=$1 id
  au_name_ok "$name" || return 2
  au_ready || return 1
  au_lock_take || return 1
  au_refuse_stopped || return 1
  if au_key_find "$name"; then au_say "A device named $name already has a key: \`auster key show $name\` shows it."; return 1; fi
  if [ "${#AU_KEY_IDS[@]}" -ge 63 ]; then au_say "63 devices have keys, as many as the engine takes beside Auster's own."; return 1; fi
  au_key_mint "$name" || { au_say "A key for $name could not be made, so nothing was changed."; return 1; }
  id=$AU_KEY_ID
  if ! au_keys_write; then
    rm -f "$AU_DATA/keys/$id" "$AU_DATA/keys/$id.name"
    au_say "The engine's key file could not be written, so no key was added."
    return 1
  fi
  au_say "A key is made for $name. Restarting the server, which reads its keys only when it starts (an answer in progress is cut)..."
  au_engine_restart || { au_say "The key for $name is made but not shown: \`auster key show $name\` shows it."; return 4; }
  if ! au_checked "$AU_DATA/keys/$id"; then
    au_say "The key for $name is made but not shown, since the server did not pass its check. \`auster key show $name\` shows it."
    return 4
  fi
  au_lock_release
  au_qr_show "$name" "$id" || true
  return 0
}

au_cmd_key_revoke() { # NAME -> the device's key taken out of the engine's key file, then its files deleted, the engine
  # restarted and the server check made: 0 or 4. Auster's own key is no device's; the last device's key stays
  local name=$1 id
  au_name_ok "$name" || return 2
  au_ready || return 1
  au_lock_take || return 1
  au_refuse_stopped || return 1
  au_key_find "$name" || { au_say "No device named $name has a key. \`auster status\` lists the devices."; return 1; }
  id=$AU_KEY_ID
  if [ "${#AU_KEY_IDS[@]}" -lt 2 ]; then
    au_say "$name has the only device key, so it is not revoked: with none, no device could use the server. Add the next device first (auster key add <name>)."
    return 1
  fi
  au_keys_write "$id" || { au_say "The engine's key file could not be written, so nothing was revoked."; return 1; }
  rm -f "$AU_DATA/keys/$id" "$AU_DATA/keys/$id.name"
  au_say "The key for $name is revoked. Restarting the server, which reads its keys only when it starts (an answer in progress is cut)..."
  au_engine_restart || return 4
  au_checked
}

au_cmd_key_show() { # NAME -> that device's key as a QR code. It takes no lock, and works while the engine is stopped
  local name=$1
  au_name_ok "$name" || return 2
  au_root_check "$AU_DATA" || return 1
  if [ "$AU_ROOT_NEW" = 1 ]; then au_say "Auster is not installed on this Mac."; return 1; fi
  au_key_find "$name" || { au_say "No device named $name has a key. \`auster status\` lists the devices."; return 1; }
  au_qr_show "$name" "$AU_KEY_ID"
}

# --- the line in ~/.zprofile (B6) ----------------------------------------------------------------------

au_zprofile_has() { [ -f "$HOME/.zprofile" ] && grep -qxF -- "$AU_ZPROFILE_LINE" "$HOME/.zprofile" 2>/dev/null; }

au_zprofile_add() { # -> AU_ZPROFILE_LINE at the end of ~/.zprofile, by rename with the file's own mode; nothing when
  # it is there. A link, or anything but this account's own file, is not rewritten: the line is printed instead
  local z="$HOME/.zprofile" t="$HOME/.zprofile.auster-new.$$" m=644
  au_zprofile_has && return 0
  if [ -L "$z" ] || { [ -e "$z" ] && { [ ! -f "$z" ] || [ "$(stat -f %u "$z" 2>/dev/null)" != "$AU_UID" ]; }; }; then
    au_say "~/.zprofile is a link, or not your own file, so Auster does not change it. For Terminal to find auster, add this line to it yourself:"
    au_say "$AU_ZPROFILE_LINE"
    return 0
  fi
  if [ -f "$z" ]; then m=$(stat -f %Lp "$z") || return 1; fi
  rm -f "$t"
  { if [ -s "$z" ]; then cat "$z"; [ "$(tail -c 1 "$z" | od -An -tx1 | tr -d ' \n')" = 0a ] || printf '\n'; fi
    printf '%s\n' "$AU_ZPROFILE_LINE"; } > "$t" && chmod "$m" "$t" && mv -f "$t" "$z" || { rm -f "$t"; return 1; }
  au_say "Added to ~/.zprofile, so that a new Terminal window finds auster: $AU_ZPROFILE_LINE"
}

au_zprofile_remove() { # -> AU_ZPROFILE_LINE taken out of ~/.zprofile wherever a line equals it byte for byte, every
  # other line as it was, by rename with the file's own mode; a file left empty is deleted (the installer made it).
  # A link, or anything but this account's own file, is not rewritten: the line is printed instead
  local z="$HOME/.zprofile" t="$HOME/.zprofile.auster-new.$$" m
  [ -e "$z" ] || [ -L "$z" ] || return 0
  grep -qxF -- "$AU_ZPROFILE_LINE" "$z" 2>/dev/null || return 0
  if [ -L "$z" ] || [ ! -f "$z" ] || [ "$(stat -f %u "$z" 2>/dev/null)" != "$AU_UID" ]; then
    au_say "~/.zprofile is a link, or not your own file, so Auster does not change it. Remove this line from it yourself:"
    au_say "$AU_ZPROFILE_LINE"
    return 0
  fi
  m=$(stat -f %Lp "$z") || return 1
  rm -f "$t"
  grep -vxF -- "$AU_ZPROFILE_LINE" "$z" > "$t"
  if [ ! -s "$t" ]; then rm -f "$t" "$z"; au_say "Auster's line is taken out of ~/.zprofile, which held nothing else."; return 0; fi
  if chmod "$m" "$t" && mv -f "$t" "$z"; then au_say "Auster's line is taken out of ~/.zprofile."; return 0; fi
  rm -f "$t"
  au_say "~/.zprofile could not be rewritten. Remove this line from it yourself: $AU_ZPROFILE_LINE"
  return 1
}

# --- what is left, and removing (B8) ------------------------------------------------------------------

au_left() { # -> lists what the data root holds, with sizes
  local e k
  au_say "What is left, in $AU_DATA:"
  for e in "$AU_DATA"/* "$AU_DATA"/.[!.]*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    k=$(du -sk "$e" 2>/dev/null | cut -f1)
    printf '  %-24s %s KB\n' "${e##*/}" "${k:-?}"
  done
}

au_root_delete() { # DIR -> DIR deleted, only when it is the data root: the path this home folder gives it, a folder
  # holding its marker file, reached from the home folder through no link (B8). Otherwise says so, deletes nothing
  local d=$1 p
  if [ -z "$d" ] || [ "$d" = / ] || [ -z "${HOME:-}" ] || [ "$HOME" = / ] || [ "$d" != "$HOME/Library/Application Support/Auster" ]; then
    au_say "$d is not Auster's data root; nothing was deleted."
    return 1
  fi
  for p in "$HOME/Library" "$HOME/Library/Application Support" "$d"; do
    if [ -L "$p" ] || [ ! -d "$p" ]; then au_say "$p is a link or not a folder, so $d is not Auster's data root any more; nothing was deleted."; return 1; fi
  done
  if [ ! -f "$d/$AU_ROOT_MARKER" ] || [ -L "$d/$AU_ROOT_MARKER" ]; then
    au_say "$d is not Auster's data root any more (it has no $AU_ROOT_MARKER); nothing was deleted."
    return 1
  fi
  rm -rf -- "$d"
}

au_remove() { # -> B8, and `install.sh remove` through the driver: stop the engine, unload both jobs and delete
  # their files and builds/stopped, clear any disabled mark launchd keeps for their labels (launchctl enable), take
  # the line out of ~/.zprofile; then list what is left and delete it only on a second yes
  local l f
  au_root_check "$AU_DATA" || return 1
  if [ "$AU_ROOT_NEW" = 1 ]; then au_say "Auster is not installed in $AU_DATA."; return 1; fi
  au_say "This stops Auster's server on this Mac, removes its two background jobs and its line in ~/.zprofile."
  au_yes "Remove Auster?" || { au_say "Nothing was changed."; return 1; }
  au_mkdir "$AU_DATA/builds" && au_lock_take || return 1
  for l in "$AU_LABEL_ENGINE" "$AU_LABEL_CHECK"; do
    au_job_loaded "$l" && launchctl bootout "gui/$AU_UID/$l"
    f=$(au_job_file "$l")
    if [ -f "$f" ] || [ -L "$f" ]; then rm -f "$f"; fi
    launchctl enable "gui/$AU_UID/$l"
  done
  rm -rf "$AU_DATA/builds/stopped"
  au_zprofile_remove
  au_say "Auster's server is stopped and its jobs are removed."
  au_left
  if ! au_yes "Delete all of it, the models included?"; then
    au_lock_release
    au_say "The files are kept. To delete them later: \"$AU_DATA/bin/auster\" remove"
    return 0
  fi
  au_lock_release
  au_root_delete "$AU_DATA" || return 1
  au_say "Auster is removed from this Mac."
}

# --- status (B6) -------------------------------------------------------------------------------------------

au_probe_read() { # -> AU_PR_RESULT, AU_PR_SPEED from the probe line of _update/engine (common/auster-check's header
  # gives its form; bound 1,024 bytes, seven lines), or 1
  local f="$AU_DATA/_update/engine" l
  [ -f "$f" ] && [ ! -L "$f" ] && [ "$(au_size "$f")" -le 1024 ] || return 1
  [ "$(wc -l < "$f" | tr -d ' ')" = 7 ] && [ "$(tail -c 1 "$f" | od -An -tx1 | tr -d ' \n')" = 0a ] || return 1
  IFS= read -r l < "$f" && [ "$l" = 'auster-record 1' ] || return 1
  l=$(sed -n 2p "$f"); au_split "$l"
  [ "${#AU_F[@]}" -eq 4 ] && [ "${AU_F[0]}" = probe ] && [[ ${AU_F[1]} =~ ^(ok|slow|open|broken|failed|down|stopped)$ ]] || return 1
  { [ "${AU_F[2]}" = - ] || [[ ${AU_F[2]} =~ $AU_RE_SPEED ]]; } && [[ ${AU_F[3]} =~ ^[1-9][0-9]{0,11}$ ]] || return 1
  AU_PR_RESULT=${AU_F[1]} AU_PR_SPEED=${AU_F[2]}
}

au_status() { # -> B6: what serves, the engine job's last start, why the engine is stopped, a job macOS has switched
  # off without Auster knowing (launchctl print-disabled), the check job's last probe, the devices, the sleep
  # setting. TODO(U3): each recipe's line; TODO(U2): a `.local` name that macOS has changed
  local s r l pd job i
  au_root_check "$AU_DATA" > /dev/null || { au_say "The data root $AU_DATA cannot be read."; return 1; }
  [ "$AU_ROOT_NEW" = 0 ] || { au_say "Auster is not installed."; return 0; }
  for s in "$AU_DATA"/builds/r*/serving; do
    [ -f "$s" ] || continue
    r=${s%/serving}; r=${r##*/}
    if au_serving_read "$r"; then
      au_say "Serving build $AU_SV_BUILD for $AU_SV_PEOPLE people at $AU_SV_CONTEXT each, on port $AU_SV_PORT."
      [ "$AU_SV_SPEED" != 0 ] || au_say "It has not passed a server check since the switch: \`auster restart\` checks it."
    fi
    au_start_read "$r" && au_say "The engine job's last start: $AU_ST_CODE."
  done
  au_stopped_read
  case "$AU_STOPPED:$AU_STOPPED_WHY" in
    no:*) ;;
    newer:*) au_say "The engine is stopped, and builds/stopped was written by a newer version of Auster." ;;
    yes:household) au_say "The engine is stopped: the household stopped it (auster stop) at $AU_STOPPED_AT. \`auster start\` starts it." ;;
    yes:open) au_say "The engine is stopped: Auster stopped it at $AU_STOPPED_AT, because it answered a request that carried no key. \`auster start\` starts it and checks it again." ;;
    *) au_say "The engine is stopped, for a reason that cannot be read (builds/stopped). \`auster start\` starts it." ;;
  esac
  pd=$(launchctl print-disabled "gui/$AU_UID" 2>/dev/null)
  for l in "$AU_LABEL_ENGINE" "$AU_LABEL_CHECK"; do
    if [ "$l" = "$AU_LABEL_ENGINE" ]; then job="engine job"; else job="check job"; fi
    if printf '%s\n' "$pd" | grep -qF -e "\"$l\" => disabled" -e "\"$l\" => true"; then
      [ "$l" = "$AU_LABEL_ENGINE" ] && [ "$AU_STOPPED" != no ] && continue   # Auster's own stop, said above
      au_say "macOS has Auster's $job switched off (System Settings, General, Login Items, Allow in the Background), so it does not start at login."
      if [ "$l" = "$AU_LABEL_ENGINE" ]; then au_say "\`auster start\` switches it on again and starts it."
      else au_say "Switch it on again there: without it, nobody is told when the server stops answering."; fi
    elif ! au_job_loaded "$l"; then
      [ "$l" = "$AU_LABEL_ENGINE" ] && [ "$AU_STOPPED" != no ] && continue
      au_say "Auster's $job is not loaded."
    fi
  done
  if au_probe_read; then
    case "$AU_PR_RESULT" in
      ok|slow) au_say "The check job's last probe: $AU_PR_RESULT, at $AU_PR_SPEED tokens a second." ;;
      *) au_say "The check job's last probe: $AU_PR_RESULT." ;;
    esac
  fi
  au_key_list
  l=
  for ((i = 0; i < ${#AU_KEY_NAMES[@]}; i++)); do l+="${l:+, }${AU_KEY_NAMES[$i]}"; done
  [ -z "$l" ] || au_say "Devices with a key: $l."
  s=$(pmset -g 2>/dev/null | awk '$1 == "sleep" { print $2; exit }')
  case "$s" in
    0) au_say "This Mac is set never to sleep." ;;
    ''|*[!0-9]*) au_say "This Mac's sleep setting cannot be read." ;;
    *) au_say "This Mac sleeps after $s minutes idle, and a sleeping Mac does not answer." ;;
  esac
  [ -d "$AU_DATA/_update" ] || au_say "There is no _update folder, so no update is looked for until the installer line is pasted again."
  return 0
}

au_usage() {
  au_say "usage: auster status | stop | start | restart | network | verify | people <n> | remove" \
    "              auster key add <name> | key revoke <name> | key show <name>" >&2
  return 2
}

auster_main() {
  set -u
  export LC_ALL=C
  local rc=2
  au_identity || exit 1
  trap 'au_lock_release; au_qr_leave' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  case "${1:-}:$#" in
    status:1) au_status; rc=$? ;;
    stop:1) au_cmd_stop; rc=$? ;;
    start:1) au_cmd_start; rc=$? ;;
    restart:1) au_cmd_restart; rc=$? ;;
    network:1) au_cmd_network; rc=$? ;;
    verify:1) au_cmd_verify; rc=$? ;;
    remove:1) au_remove; rc=$? ;;
    people:2) if [[ $2 =~ ^[1-9][0-9]?$ ]]; then au_cmd_people "$2"; rc=$?; else au_usage; fi ;;
    key:3)
      case "$2" in
        add) au_cmd_key_add "$3"; rc=$? ;;
        revoke) au_cmd_key_revoke "$3"; rc=$? ;;
        show) au_cmd_key_show "$3"; rc=$? ;;
        *) au_usage ;;
      esac ;;
    update:*|rollback:*|unhold:*|cleanup:*) au_cmd_later "$1"; rc=$? ;;
    *) au_usage ;;
  esac
  exit "$rc"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then auster_main "$@"; fi
