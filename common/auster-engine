#!/bin/bash
# jobs/auster-engine: the engine job's program (docs/plans/v0.1.md, B4), run by launchd as
# `/bin/bash <data root>/jobs/auster-engine` with PATH=/usr/bin:/bin:/usr/sbin:/sbin and nothing else.
# Copied byte for byte from the tree's common/auster-engine (B3 step 3), and replaced by rename.
#
# Written by V5 (2026-11-26) only so that a first install can start the engine and make its server
# check: it follows B4's steps, but V6 builds this program and its tests (T70 to T76, T97's start half,
# T103, T104), and may change anything here. TODO(V6): every test of it.
#
# It starts what builds/<recipe id>/serving names, and nothing else. It reads no `_update`, fetches
# nothing, and runs no Auster program but osascript for the UI config.
set -u
export LC_ALL=C
T=$'\t'
here=$(cd "$(dirname "$0")" && pwd -P) || exit 1
DATA=${here%/jobs}
[ "$DATA" != "$here" ] || { echo "auster-engine: not in a data root's jobs folder" >&2; exit 1; }
RE_SHA='^[0-9a-f]{64}$'
RE_KEY='^[0-9a-f]{32}$'
RE_LSTART='^(Mon|Tue|Wed|Thu|Fri|Sat|Sun) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [ 123][0-9] [0-2][0-9]:[0-5][0-9]:[0-5][0-9] [0-9]{4}$'
BOOT=$(sysctl -n kern.bootsessionuuid 2>/dev/null)

split() { local rest=$1; F=(); while :; do case "$rest" in *"$T"*) F+=("${rest%%"$T"*}"); rest=${rest#*"$T"} ;; *) F+=("$rest"); break ;; esac; done; }
sha() { local o; o=$(openssl dgst -sha256 "$1" 2>/dev/null) || return 1; o=${o##*= }; [[ $o =~ $RE_SHA ]] && printf '%s' "$o"; }

recipe=
for s in "$DATA"/builds/r*/serving; do [ -f "$s" ] && [ ! -L "$s" ] && { recipe=${s%/serving}; recipe=${recipe##*/}; break; }; done
[ -n "$recipe" ] || { echo "auster-engine: nothing is serving" >&2; sleep 60; exit 1; }
B="$DATA/builds/$recipe"

start_record() { # CODE ADDRESS -> builds/<recipe>/start (B4 step 6), by rename
  local t="$B/.start.new.$$"
  printf 'auster-record 1\ncode\t%s\naddress\t%s\nboot\t%s\ntime\t%s\n' "$1" "$2" "$BOOT" "$(date +%s)" > "$t" && mv -f "$t" "$B/start"
}
fault() { start_record "$1" -; echo "auster-engine: $1" >&2; sleep 60; exit 1; }   # B4: wait 60 s, then exit

# 1. Wait while builds/paused names a live process of this boot (D3.1), at most 30 minutes.
waited=0
while [ -f "$DATA/builds/paused" ] && [ ! -L "$DATA/builds/paused" ] && [ "$waited" -lt 360 ]; do
  IFS= read -r line < "$DATA/builds/paused" || break
  split "$line"
  [ "${#F[@]}" -eq 4 ] && [ "${F[0]}" = 'auster-record 1' ] && [ "${F[2]}" = "$BOOT" ] || break
  [[ ${F[3]} =~ $RE_LSTART ]] || break
  s=$(ps -p "${F[1]}" -o lstart= 2>/dev/null) || break
  s=${s%"${s##*[![:space:]]}"}
  [ "$s" = "${F[3]}" ] || break
  sleep 5
  waited=$((waited + 1))
done

# 2. Read serving, after the wait.
lines=()
while IFS= read -r l; do lines+=("$l"); done < "$B/serving"
[ "${#lines[@]}" -eq 5 ] && [ "${lines[0]}" = 'auster-descriptor 1' ] || fault engine-hash
split "${lines[1]}"; build=${F[1]}; template=${F[4]}; system=${F[5]}; temp=${F[11]}; topp=${F[12]}
split "${lines[2]}"; engine=${F[6]}
split "${lines[3]}"; model=${F[6]}
split "${lines[4]}"; people=${F[1]}; context=${F[2]}; port=${F[3]}; list=${F[4]}
for v in "$template" "$system" "$engine" "$model" "$list"; do [[ $v =~ $RE_SHA ]] || fault engine-hash; done
[[ $people =~ ^[1-9][0-9]?$ ]] && [[ $context =~ ^[1-9][0-9]{0,6}$ ]] && [[ $port =~ ^[1-9][0-9]{0,4}$ ]] || fault engine-hash

# 3. The key file: a regular file, not a link, mode 0600, one to 64 lines, each a key and nothing else.
kf="$DATA/keys/engine.keys"
[ -f "$kf" ] && [ ! -L "$kf" ] && [ "$(stat -f %Lp "$kf")" = 600 ] || fault keys
n=0
while IFS= read -r k || [ -n "$k" ]; do n=$((n + 1)); [[ $k =~ $RE_KEY ]] || fault keys; done < "$kf"
[ "$n" -ge 1 ] && [ "$n" -le 64 ] || fault keys

# 4. The engine and the template against their sha256s: the file list is made again and must be the same.
root="$DATA/engines/$engine/root"
[ -d "$root" ] && [ ! -L "$root" ] || fault engine-hash
listing=$(cd "$root" && find . \( -type f -o -type l \) -print | sed 's|^\./||' | LC_ALL=C sort | while IFS= read -r p; do
  if [ -L "$p" ]; then printf '%s\tlink\t%s\n' "$p" "$(readlink "$p")"; else printf '%s\t%s\t%s\n' "$p" "$(stat -f %z "$p")" "$(sha "$p")"; fi
done)
[ "$(printf '%s\n' "$listing" | shasum -a 256 | cut -c1-64)" = "$list" ] || fault engine-hash
[ "$(sha "$DATA/store/$template")" = "$template" ] || fault engine-hash
program=$(printf '%s\n' "$listing" | awk -F'\t' '$2 != "link" && ($1 == "llama-server" || $1 ~ /\/llama-server$/) { print $1 }')
[ -n "$program" ] && [ "$(printf '%s\n' "$program" | wc -l | tr -d ' ')" = 1 ] && [ -x "$root/$program" ] || fault engine-hash

# 5. The home address: the default route's interface is a hardware port, its IPv4 address is private,
# and the router's hardware address is the one recorded in builds/mac (BD9).
r=$(route -n get default 2>/dev/null) || fault no-network
if_=$(printf '%s\n' "$r" | awk '$1 == "interface:" { print $2 }')
gw=$(printf '%s\n' "$r" | awk '$1 == "gateway:" { print $2 }')
[ -n "$if_" ] && [ -n "$gw" ] || fault no-network
networksetup -listallhardwareports 2>/dev/null | grep -qx "Device: $if_" || fault not-home
addr=$(ipconfig getifaddr "$if_" 2>/dev/null)
case "$addr" in 10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) ;; *) fault not-home ;; esac
mac=$(arp -n "$gw" 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "at") { print $(i + 1); exit } }')
router=
IFS=: read -r -a parts <<< "$mac"
[ "${#parts[@]}" -eq 6 ] || fault not-home
for p in "${parts[@]}"; do [[ $p =~ ^[0-9a-fA-F]{1,2}$ ]] || fault not-home; p=0$p; router+=${router:+:}$(printf '%s' "${p: -2}" | tr 'A-F' 'a-f'); done
[ "$(sed -n 's/^router	//p' "$DATA/builds/mac" 2>/dev/null)" = "$router" ] || fault not-home

# 6. The start record.
start_record starting "$addr"

# 7. Keep the Mac awake while the engine runs, if the household said yes (BD10).
[ "$(sed -n 's/^keep-awake	//p' "$DATA/builds/mac" 2>/dev/null)" = yes ] && caffeinate -i -w $$ &

# 8. The UI config, by JSON.stringify with one key, then the engine with an empty environment.
name=$(scutil --get LocalHostName 2>/dev/null)
[[ $name =~ ^[A-Za-z0-9-]{1,63}$ ]] || name=
osascript -l JavaScript -e '
function run(a) {
  var d = $.NSData.dataWithContentsOfFile(a[0]);
  var s = ObjC.unwrap($.NSString.alloc.initWithDataEncoding(d, $.NSUTF8StringEncoding));
  return JSON.stringify({ systemMessage: s });
}' "$DATA/store/$system" > "$B/.ui-config.new.$$" 2>/dev/null && mv -f "$B/.ui-config.new.$$" "$B/ui-config.json" || fault engine-hash
cors="http://$addr:$port"
[ -z "$name" ] || cors="$cors,http://$name.local:$port"
cd "$DATA/store" || fault engine-hash
exec env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin "$root/$program" -m "$model" --alias "$build" \
  -c $((people * context)) -np "$people" --host "127.0.0.1,$addr" --port "$port" \
  --api-key-file ../keys/engine.keys --offline --no-slots --no-webui-mcp-proxy --cors-origins "$cors" \
  --jinja --chat-template-file "$template" --ui-config-file "../builds/$recipe/ui-config.json" \
  --temp "$temp" --top-p "$topp" --fit off -ngl all
